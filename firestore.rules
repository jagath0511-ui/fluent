rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their OWN profile document.
    // This is the actual "lock" — Firebase Auth proves who someone is,
    // and this rule is what stops user A from reading or editing user B's data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

